# 复制为 .env 后按本机环境调整；不要提交包含真实凭据的 .env。
APP_NAME=Enterprise AI Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
# 此字段已在 Settings 中声明，但尚未接入应用日志配置；服务器日志级别可通过启动参数指定。
LOG_LEVEL=INFO

# ---- PostgreSQL（由 docker compose 启动）----
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=e_ai_database
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5432/e_ai_database

# 测试使用独立数据库；不得指向需要保留数据的数据库。
# 当前 Settings 在应用启动时也要求提供此字段。
TEST_DATABASE_URL=postgresql+psycopg://app:change-me@127.0.0.1:5432/e_ai_database_test

# ---- Redis 与缓存 ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_EMBEDDING_TTL_SECONDS=604800
REDIS_SEARCH_TTL_SECONDS=60
REDIS_SOCKET_TIMEOUT_SECONDS=1.0

# ---- 文件存储 ----
UPLOAD_DIR=data/uploads

# ---- Embedding 与模型缓存 ----
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32
HF_ENDPOINT=https://hf-mirror.com
# 用户主目录下的缓存路径；也可按本机环境修改为持久化目录。
HF_HOME=~/.cache/huggingface

# ---- 检索与精排 ----
MIN_VECTOR_SCORE=0.45
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_MAX_LENGTH=512
# 精排门控默认关闭；设置非零阈值前应根据实际模型分数范围进行验证。
MIN_RERANK_SCORE=0.0

# ---- LLM（OpenAI 兼容接口：LM Studio / vLLM / 云端 API）----
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=qwen2.5-14b-instruct
LLM_API_KEY=lm-studio
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.2

# ---- Agent 与工具限制 ----
AGENT_MAX_STEPS=4
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=3000
PYTHON_MAX_EXPRESSION_LENGTH=1000
PYTHON_MAX_AST_NODES=100
PYTHON_MAX_EXPONENT=20
PYTHON_MAX_ABS_VALUE=1e100

# ---- RQ 异步文档入库队列 ----
INGEST_QUEUE_NAME=document-ingest
INGEST_JOB_TIMEOUT_SECONDS=900
# 以下两个字段已在 Settings 中声明，但当前应用代码未使用。
# INGEST_STUCK_AFTER_SECONDS=1800
# INGEST_ERROR_MAX_LENGTH=1000

# ---- JWT ----
# 本地开发时请替换为高强度随机值；不要提交生产密钥。
JWT_SECRET_KEY=change-this-to-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
